{
  "name": "room-shell-h5",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "Standalone live-room and voice-room H5 bundle for native iOS/Flutter embedding.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm verify:app-config && vue-tsc --noEmit && vite build && node scripts/write-build-manifest.mjs && pnpm verify:build",
    "preview": "vite preview",
    "lint": "eslint src scripts vite.config.ts postcss.config.ts eslint.config.mjs commitlint.config.ts",
    "lint:fix": "pnpm lint --fix",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,less}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,less}\" \"*.{ts,mjs,json}\"",
    "stylelint": "stylelint \"src/**/*.{css,less,vue}\"",
    "test": "vitest run",
    "check:deps": "dependency-cruiser src --config .dependency-cruiser.cjs",
    "check:exports": "knip --include dependencies,unlisted,binaries,unresolved",
    "verify:app-config": "node scripts/verify-app-config.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.83.0",
    "agora-rtc-sdk-ng": "^4.24.3",
    "axios": "^1.11.0",
    "dexie": "^4.0.11",
    "nim-web-sdk-ng": "10.9.30",
    "pako": "2.2.0",
    "pinia": "^3.0.4",
    "svgaplayerweb": "2.3.2",
    "swiper": "^14.1.0",
    "vant": "^4.10.0",
    "vconsole": "^3.15.1",
    "vue": "^3.5.38",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.3",
    "yyeva": "1.2.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.0.0",
    "@types/pako": "2.0.4",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.4",
    "dependency-cruiser": "^17.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "knip": "^5.62.0",
    "less": "^4.6.6",
    "lint-staged": "^17.3.0",
    "postcss-html": "^1.8.0",
    "postcss-less": "^6.0.0",
    "postcss-mobile-forever": "^5.0.0",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^16.23.0",
    "stylelint-config-standard-less": "^3.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint:staged && pnpm typecheck",
    "commit-msg": "pnpm commitlint $1"
  },
  "lint-staged": {
    "*.{ts,vue,mjs,cjs}": "eslint --fix",
    "src/**/*.js": "eslint --fix"
  }
}
